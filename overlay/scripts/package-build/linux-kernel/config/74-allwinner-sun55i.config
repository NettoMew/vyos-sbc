# 74-allwinner-sun55i.config — Allwinner A523/A527/T527（sun55i，Radxa Cubie A5E）支持，
# 叠加在通用 arm64 vyos_defconfig 与 70–72 Rockchip 片段之上（merge_config.sh 按 glob
# 全量合并：一个内核带全 SoC，Rockchip/Allwinner 片段共存互不冲突——本片段的符号对
# RK35xx 板是死代码、零副作用；反之 70–72 对 A5E 亦然）。
#
# vyos_defconfig 已有 ARCH_SUNXI=y、SUNXI_CCU/SUNXI_SRAM/SUNXI_MBUS=y、SERIAL_8250_DW=y、
# SUN6I_R_INTC（ARCH_SUNXI select），但只到 H616 一代：A523 的 CCU/pinctrl/PCK-600 缺失，
# PMIC/MMC/网卡不是 =m 就是 not set。启动链路（时钟/引脚/PMIC/MMC/串口/网卡）一律内建
# （=y）：MMC 是根盘、PMIC 给 MMC 与 PHY 供电，不赌 initrd 模块序（同 R5S 缺 rk809、
# E52C 缺 SPI 的教训）。
# 参考：Armbian linux-sunxi64 config（同族取舍）；驱动/compatible 对应关系按 6.18.50 源码核对。

## SoC 基础设施（时钟 / 引脚 / 电源域 / 看门狗 / RTC / efuse）
CONFIG_ARCH_SUNXI=y
# A523 CCU 三件：主 CCU、PRCM R-CCU（r_i2c0=PMIC 总线的时钟）、MCU CCU（NPU/DSP 侧）。
CONFIG_SUNXI_CCU=y
CONFIG_SUN55I_A523_CCU=y
CONFIG_SUN55I_A523_R_CCU=y
CONFIG_SUN55I_A523_MCU_CCU=y
# A523 用新式 DT 驱动的 pinctrl（pin/function 全由 DTS 的 allwinner,pinmux 描述，
# 故 gmac1 的 PJ 组 rgmii1 pinmux 无需驱动侧改动）；主 PIO + R-PIO（PMIC I2C、LED 在 PL 组）。
CONFIG_PINCTRL_SUN55I_A523=y
CONFIG_PINCTRL_SUN55I_A523_R=y
CONFIG_SUNXI_SRAM=y
# 电源域：PPU（sun55i-a523-ppu）+ PCK-600（gmac1 挂 PD_VO1，缺它 gmac1 永不 probe）。
CONFIG_SUN20I_PPU=y
CONFIG_SUN55I_PCK600=y
CONFIG_SUNXI_WATCHDOG=y
CONFIG_RTC_DRV_SUN6I=y
CONFIG_NVMEM_SUNXI_SID=y
# 串口：sunxi 的 uart 是 snps,dw-apb-uart → 8250_DW（vyos_defconfig 已 =y，此处重申）。
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_DW=y

## PMIC — AXP717（主）+ AXP323（CPU 大簇/GPU 电源）挂 r_i2c0，启动命脉：
## cldo3 供 mmc0(SD) vmmc 与 gmac0 PHY、cldo4 供 gmac1 PHY/PJ 组 IO、dcdc 供 CPU/DRAM。
## 缺它则 MMC/网卡永久 deferred probe → live-boot 找不到根盘死循环。
CONFIG_I2C=y
CONFIG_I2C_MV64XXX=y
CONFIG_MFD_AXP20X=y
CONFIG_MFD_AXP20X_I2C=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_AXP20X=y
CONFIG_INPUT_AXP20X_PEK=y
# 非启动件（USB-C 供电状态 / 板载电压温度 ADC → iio-hwmon），模块即可
CONFIG_AXP20X_POWER=m
CONFIG_AXP20X_ADC=m

## 存储 — SD/eMMC（根盘所在，sunxi-mmc，a523 用 sun20i-d1-mmc 兼容路径）
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SUNXI=y

## 以太网 — 两口都是 SoC 内置 dwmac + 外置 RGMII PHY（REALTEK_PHY/MOTORCOMM_PHY 已在 70）
## gmac0：sun55i-a523-gmac0 → dwmac-sun8i（sun50i-a64-emac 兼容路径）
## gmac1：sun55i-a523-gmac200 → dwmac-sun55i（snps,dwmac-4.20a 核）
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_SUN8I=y
CONFIG_DWMAC_SUN55I=y

## USB — sun55i-a523-usb-phy（sun20i-d1 兼容路径）+ generic-ehci/ohci（70 已 =y）
CONFIG_PHY_SUN4I_USB=y

## PCIe / M.2 — A523 RC + shared PCIe/USB3 INNO PHY (Armbian backport 170–174).
## Generic NVMe alone cannot enumerate the bus. PCIe mode keeps USB at USB2;
## both firmware-passed and fallback kernel DTs describe the same hardware.
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIE_SUN55I_RC=y
CONFIG_AW_INNO_COMBOPHY=y
CONFIG_BLK_DEV_NVME=y
